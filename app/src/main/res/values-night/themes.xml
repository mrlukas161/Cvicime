<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tmavy rezim: okno je od prveho okamihu uhlove, ziadny biely zablesk pri starte.
        Theme.Cvicime sa tu NEdefinuje - dedi z tohto Base (aj variant vo values-v31).
    -->
    <style name="Base.Theme.Cvicime" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/pozadie_okna</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
